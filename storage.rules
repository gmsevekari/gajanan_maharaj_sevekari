rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Mirrors firestore.rules's own isAdmin() exactly (same auth model:
    // a verified-email user with a matching admin_allowlist doc), using
    // Storage Rules v2's cross-service Firestore read since Storage has
    // no admin_allowlist of its own.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email_verified == true &&
             firestore.exists(/databases/(default)/documents/admin_allowlist/$(request.auth.token.email));
    }

    // Sign-Up Signups header/display image: one object per signup at a
    // fixed path (signups/{signupId}/header), publicly readable
    // like the signup itself, admin-only to write or delete. The size and
    // content-type bounds are the real security boundary here - the app
    // also checks file size client-side before even attempting an
    // upload, but that's just a fast-fail UX nicety, not something a
    // modified client could be trusted to enforce.
    //
    // contentType is an explicit raster-format allowlist, not
    // 'image/.*' - Storage serves whatever Content-Type the uploader
    // declares without sniffing the actual bytes, and image/svg+xml is a
    // script-capable XML format. A crafted SVG uploaded under that
    // declared type would be served back as image/svg+xml from this
    // object's public URL and could execute script if ever opened
    // directly in a browser outside this app. None of these raster
    // formats can carry executable script the same way.
    match /signups/{signupId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in
           ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/gif'];
      allow delete: if isAdmin();
    }
  }
}
