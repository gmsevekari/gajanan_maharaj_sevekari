{
  "name": "firestore-rules-test",
  "description": "Automated verification of firestore.rules and storage.rules against the Firebase emulators",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:emulators": "firebase emulators:exec --project demo-signup-signups-rules-test --only firestore,storage \"npm test\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0"
  }
}
